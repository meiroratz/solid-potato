# Google OAuth2 credentials (download from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Gmail: address the briefing will be sent TO (usually your own)
BRIEFING_RECIPIENT=you@example.com

# Weather: your city (used with wttr.in, no API key required)
WEATHER_LOCATION=New York

# Trello (get from https://trello.com/app-key)
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token
# Comma-separated board names to include (leave blank for all boards)
TRELLO_BOARDS=

# How many days of Trello activity to include
TRELLO_ACTIVITY_DAYS=1

# How many unread email threads to summarise
EMAIL_THREAD_LIMIT=10
